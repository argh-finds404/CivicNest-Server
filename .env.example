PORT=3000

# MongoDB
DB_USER=
DB_PASS=
# MONGODB_URI=mongodb+srv://...

# Stripe
PAYMENT_GATEWAY_KEY=
STRIPE_WEBHOOK_SECRET=

# SSLCommerz
SSL_STORE_ID=
SSL_STORE_PASSWD=
SSL_IS_LIVE=false

CLIENT_BASE_URL=http://localhost:5173
GEMINI_API_KEY=
# Optional: defaults to gemini-2.5-flash
# GEMINI_MODEL=

# Firebase admin credentials
# FIREBASE_SERVICE_ACCOUNT=
# FIREBASE_SERVICE_ACCOUNT_PATH=

# Prisma (optional): defaults to MONGODB_URI with the communityDB database.
# Prisma on MongoDB needs a replica set (Atlas clusters are).
# DATABASE_URL=mongodb+srv://.../communityDB?retryWrites=true&w=majority

# Reviewer demo accounts (npm run seed:reviewers)
# REVIEWER_PASSWORD=CivicNest@2026
